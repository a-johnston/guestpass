# Project dependencies only; devbox adds the terminal runtime and selected harness.
# No build step: python3 serves the app and runs dev/mock_server.py, node runs `node --test test/`.
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates python3 libatomic1 \
    && rm -rf /var/lib/apt/lists/*
# Ubuntu's nodejs is 18; take the current release's binary from the official image
# (it links libatomic, installed above).
COPY --from=docker.io/library/node:26-slim /usr/local/bin/node /usr/local/bin/node
